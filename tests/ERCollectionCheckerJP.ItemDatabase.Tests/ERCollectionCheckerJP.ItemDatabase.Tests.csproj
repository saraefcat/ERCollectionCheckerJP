<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RequiresPrivateRegressionData>true</RequiresPrivateRegressionData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.analyzers" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ERCollectionCheckerJP.ItemDatabase\ERCollectionCheckerJP.ItemDatabase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ERCollectionCheckerJPPrivateDataRoot)\1.17\curation\tarnished-pack-flags.json"
          Link="TestData\tarnished-pack-flags.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ERCollectionCheckerJPPrivateDataRoot)\1.17\fragments\*.json"
          Link="TestData\fragments\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
