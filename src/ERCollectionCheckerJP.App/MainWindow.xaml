<Window x:Class="ERCollectionCheckerJP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/ERCollectionCheckerJP;component/Assets/ERCollectionCheckerJP.ico"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        Background="#0B0F14" Foreground="#E8EDF3"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#141A22" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#1A222C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3542" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8EDF3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#93A1B2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D2B06F" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#5C4D32" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#101419" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E4C483" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#25303C" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0F141B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#151A20" />
            <Setter Property="Background" Value="#E5E9EE" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#222C37" />
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="#171E27" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202A35" />
            <Setter Property="Foreground" Value="#B8C3CF" />
            <Setter Property="BorderBrush" Value="#303C49" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3428" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentDarkBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <TextBlock Text="ER" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14" />
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,22,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding WindowTitle}" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="ELDEN RING 1.17 COLLECTION VIEWER" Style="{StaticResource MutedText}" FontSize="10" />
            </StackPanel>
            <Border Grid.Column="2" Background="#121820" BorderBrush="#27313D" BorderThickness="1"
                    CornerRadius="7" Padding="11,7" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Width="58" Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 Foreground="{StaticResource AccentBrush}" Background="#26303B" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                               Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
            <Border Grid.Column="3" Background="#183226" CornerRadius="12" Padding="12,5"
                    Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ReadOnlyLabel}" Foreground="#75D99B" FontSize="11" FontWeight="Bold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SaveLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SavePath}" IsReadOnly="True" IsEnabled="{Binding CanEditSelection}"
                                 ToolTip="{Binding SavePath}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding SlotLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CharacterComboBox" ItemsSource="{Binding SlotOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedSlotIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSelection}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CollectionModeComboBox" ItemsSource="{Binding ModeOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedMode, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Language, Mode=TwoWay}" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                        <Button Content="{Binding BrowseLabel}" Command="{Binding BrowseCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" MinWidth="120" />
                        <Button Content="{Binding AnalyzeLabel}" Command="{Binding AnalyzeCommand}" MinWidth="110" />
                    </WrapPanel>
                    <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5" Margin="0,8,0,0"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ResultLabel}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding ResultSourceText}" Margin="0,3,0,0" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="{Binding LastScanLabel}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding LastScanText}" Margin="0,3,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="13" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding OverallProgressLabel}" Style="{StaticResource MutedText}" />
                    <Grid Grid.Row="1" Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressCountText}" FontSize="22" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="28" FontWeight="Bold"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <ProgressBar Height="6" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" Background="#26303B" BorderThickness="0" />
                        <TextBlock Text="{Binding CoverageText}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding SummaryDetailText}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding CategoryProgressLabel}" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                    <ItemsControl ItemsSource="{Binding CategorySummaries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" BorderBrush="#2B3744"
                                        BorderThickness="1" Padding="8,6" Margin="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="1" Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" Foreground="{Binding Accent}"
                                                       Margin="7,0,0,0" FontSize="17" FontWeight="Bold" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding SearchLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="StateFilterComboBox" ItemsSource="{Binding StateFilterOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedStateFilter, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CategoryFilterComboBox" ItemsSource="{Binding CategoryOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedCategory, Mode=TwoWay}" />
                </StackPanel>
                <Button Grid.Column="3" Content="{Binding ClearFiltersLabel}" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,19,0,0" />

                <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ContentPackLabel}" Style="{StaticResource MutedText}"
                                   Margin="0,0,14,0" VerticalAlignment="Center" />
                        <CheckBox Content="{Binding BaseGameLabel}" IsChecked="{Binding IncludeBaseGame}" />
                        <CheckBox Content="{Binding ShadowLabel}" IsChecked="{Binding IncludeShadowOfTheErdtree}" />
                        <CheckBox Content="{Binding TarnishedLabel}" IsChecked="{Binding IncludeTarnishedPack}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox Content="{Binding DeveloperModeLabel}" IsChecked="{Binding DeveloperMode}" />
                        <CheckBox Content="{Binding DataOnlyLabel}" IsChecked="{Binding ShowDataOnlyItems}"
                                  IsEnabled="{Binding IsDataOnlyToggleEnabled}" Margin="0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#19212A" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ItemListLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CopyFeedbackText}" Style="{StaticResource MutedText}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding CopyNameLabel}"
                                    Command="{Binding CopySelectedItemNameCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="10,0,12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding VisibleItemsText}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="ItemDataGrid" Grid.Row="1" ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False" AlternationCount="2" ScrollViewer.CanContentScroll="True"
                              CanUserSortColumns="True" ClipboardCopyMode="None">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedItemNameCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="100" SortMemberPath="StateText">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{Binding DataContext.StateLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#29333E" BorderBrush="{Binding StateBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="7,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                                       FontWeight="SemiBold" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="2.3*" SortMemberPath="PrimaryName">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{Binding DataContext.NameColumnLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PrimaryName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SecondaryName}" Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="130" Binding="{Binding CategoryText}" SortMemberPath="CategoryText">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding DataContext.CategoryLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="160" Binding="{Binding ContentPackText}" SortMemberPath="ContentPackText">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding DataContext.ContentColumnLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="NoteColumn" Width="*" Binding="{Binding DetailText}"
                                                SortMemberPath="DetailText" Visibility="Collapsed">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding DataContext.NoteColumnLabel, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="ItemDetailsPanel" Grid.Column="1" Style="{StaticResource PanelBorder}"
                    Padding="14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding DetailLabel}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Grid.Row="1" Text="{Binding SelectItemLabel}" Margin="0,16,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <TextBlock Text="{Binding PrimaryName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SecondaryName}" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" Margin="0,3,0,12" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding CategoryText}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ContentPackText}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                            <TextBlock Text="{Binding DataContext.NoteColumnLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,3,0,12" />
                            <TextBlock Text="{Binding DataContext.ScopeLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" Margin="0,3,0,12" />
                            <TextBlock Text="{Binding DataContext.ExclusionLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding ExclusionText}" TextWrapping="Wrap" Margin="0,3,0,12" />
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.ParamIdLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding ParamIdText}" FontFamily="Consolas" Margin="0,3,0,9" />
                                <TextBlock Text="Key" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding Source.Key}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
