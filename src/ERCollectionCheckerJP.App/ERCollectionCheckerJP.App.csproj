<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ERCollectionCheckerJP.Application\ERCollectionCheckerJP.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ERCollectionCheckerJPRuntimeDataRoot)\**\*.json">
      <LogicalName>ERCollectionCheckerJP.RuntimeData/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ERCollectionCheckerJP.ico" />
    <Resource Include="Assets\ERCollectionCheckerJP.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE"
          Link="LICENSE"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\README.md"
          Link="README.md"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\ERCollectionCheckerJP.ico</ApplicationIcon>
    <RequiresPrivateRuntimeData>true</RequiresPrivateRuntimeData>
    <Authors>ER Collection Checker JP contributors</Authors>
    <Description>PC版ELDEN RINGのセーブデータからアイテム収集状況を表示します。</Description>
  </PropertyGroup>

</Project>
